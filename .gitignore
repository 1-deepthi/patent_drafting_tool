# --- Environment & secrets (never commit) ---
backend/.env
frontend/.env
.env
.env.*
!.env.example
backend/secrets/*
!backend/secrets/.gitkeep
secrets/
*.pem
*.key
firebase-service-account*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json

# --- Firebase CLI (local caches and debug logs) ---
.firebase/
firebase-debug.log*
firestore-debug.log*
storage-debug.log*
database-debug.log*
pubsub-debug.log*
ui-debug.log*
emulator-debug.log*

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
backend/storage_data/
backend/storage_data_test/
*.egg-info/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local reference clones (never commit; see CONTRIBUTING.md) ---
ref-repos/

# --- Local tooling output ---
.trace/
backend/.trace/

# --- OS / editors ---
