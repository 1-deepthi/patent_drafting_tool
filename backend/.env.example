# Database (Neon in production, local Postgres container in development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patent_platform

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Session token signing
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Holds ONLY the transient OAuth state/nonce during the Google redirect —
# separate secret from JWT_SECRET on purpose
SESSION_SECRET=change-this-to-a-different-long-random-string

# Google Gemini
GEMINI_API_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=patent-platform-files
R2_ENDPOINT_URL=

# Email (provider TBD — Resend or Brevo)
EMAIL_PROVIDER_API_KEY=

# Redis — not used yet, added at the Phase 6/7 Celery trigger points
REDIS_URL=

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Dev-only login bypass — lets you test RBAC without Google OAuth credentials.
# NEVER set this to true outside local development. It is also hard-gated by
# ENVIRONMENT=development in code, as a second safety net.
DEV_LOGIN_ENABLED=true

# --- Phase 10 hardening/deployment -----------------------------------------

# Comma-separated Host header allowlist (TrustedHostMiddleware). "*" is fine
# for local dev; app/core/startup_checks.py refuses to boot in production
# with this still wildcarded. Set to your real Koyeb domain(s), e.g.
# your-app.koyeb.app
ALLOWED_HOSTS=*

# In-memory rate limiting (slowapi) — per-instance, not shared across
# replicas; see app/core/rate_limit.py. RATE_LIMIT_ENABLED=false is only
# meant for CI/tests (see backend/tests/conftest.py) — leave it true
# everywhere else, including local dev.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute
