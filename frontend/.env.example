# Backend API base URL
VITE_API_URL=http://localhost:8000

# Firebase Web SDK config — Firebase console → Project settings → Your apps →
# Web app → SDK setup and configuration. These values are public by design;
# the Admin service-account key stays server-side in backend/secrets/.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
