# Backend API base URL
VITE_API_URL=http://localhost:8000

# Purely cosmetic: shows/hides the Dev Login panel on the login page.
# The REAL gate is server-side (DEV_LOGIN_ENABLED in backend/.env) — setting
# this to true here does nothing if the backend flag is off; the request
# will just 404. Keep this in sync with the backend during local dev only.
VITE_DEV_LOGIN_ENABLED=true
