rules_version = '2';

// Uploads and downloads are proxied by the backend, which stores and streams
// blobs with the Admin SDK. The client never holds a Storage reference, so
// deny direct access. A future direct-to-Storage upload flow must add a
// narrowly scoped rule here and in the API at the same time.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
